# Gemini (detection, identify, match, prompts, checks), Nano Banana and Gemini Omni run on Vertex AI. Credentials come
# from `gcloud auth application-default login` locally and from the service account on Cloud Run; no API key is used.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Backends: gemini | mock (offline stand-in for tests)
CAMEO_API_LLM=gemini
# Cloud Vision object localization: cloud | mock | off
CAMEO_VISION=cloud
# Extra allowed browser origins, comma-separated (localhost on any port is always allowed)
CAMEO_CORS_ORIGINS=https://your-site.web.app
# Cloud Storage bucket for durable copies of uploads, generated media, spending counters and analytics, so the
# server can scale to zero and redeploy without losing them (unset: everything stays on local disk)
CAMEO_BUCKET=
# Upload limits
CAMEO_MAX_SECONDS=10
CAMEO_MAX_UPLOAD_MB=100
